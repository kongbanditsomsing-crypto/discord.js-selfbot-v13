<div id="login-container" style="background:#313338; color:white; padding:20px; text-align:center;">
    <h2>Discord Bot Web Login</h2>
    <input type="password" id="botToken" placeholder="Enter Bot Token..." style="padding:10px; width:80%; margin-bottom:10px; background:#1e1f22; color:white; border:none; border-radius:4px;">
    <br>
    <button onclick="submitToken()" style="padding:10px 20px; background:#5865f2; color:white; border:none; border-radius:4px; cursor:pointer;">Login</button>
</div>

<script>
    async function submitToken() {
        const token = document.getElementById('botToken').value;
        const res = await fetch('/api/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token })
        });
        const data = await res.json();
        if(data.success) {
            alert('Login สำเร็จ: ' + data.username);
            document.getElementById('login-container').style.display = 'none'; // ซ่อนหน้าล็อกอินแล้วเข้าสู่หน้าแชท
        } else {
            alert('Error: ' + data.error);
        }
    }
</script>
